# Used by `npm run dev`. "/" = same origin: Vite forwards /api and /media to DEV_PROXY_TARGET (see vite.config.js),
# so the live server does not need CORS for localhost.
VITE_API_BASE_URL=/
# Backend that the dev proxy forwards to (use http://localhost:3013 for a backend running on this PC).
DEV_PROXY_TARGET=https://adda.skillinnovex.in
