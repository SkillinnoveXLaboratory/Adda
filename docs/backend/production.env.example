# Production settings for the VPS (adda.skillinnovex.in -> OpenLiteSpeed -> 127.0.0.1:3015).
# Copy to Backend/.env ON THE SERVER and fill in the secrets. Never commit the filled file.
NODE_ENV=production
PORT=3015
TRUST_PROXY=1
MONGODB_URI=
MONGODB_DB_NAME=addaapp
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HASH_SECRET=
PUBLIC_API_BASE_URL=https://adda.skillinnovex.in
# Origin(s) where SocialPanel is hosted, comma-separated
CORS_ORIGINS=https://panel.adda.skillinnovex.in
PANEL_BASE_URL=https://panel.adda.skillinnovex.in

# Resident sign-in needs a real SMS provider in production ("test" is refused): msg91 or twilio
OTP_PROVIDER=none
OTP_PROVIDER_API_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/home/addaapp/uploads
MAX_UPLOAD_MB=8
JOBS_ENABLED=true

# Interim resident sign-in with phone + password (no SMS). Phone numbers are NOT verified; turn off once SMS OTP works.
RESIDENT_PASSWORD_LOGIN=true

# Sign-in attempts per IP per 15 min (accounts also lock after 5 wrong passwords)
LOGIN_RATE_LIMIT=20
PUBLIC_FORM_RATE_LIMIT=60
