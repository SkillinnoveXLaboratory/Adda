# AddaApp backend configuration. Copy to .env and fill in. NEVER commit .env or copy these into AddaApp/SocialPanel.
NODE_ENV=development            # development | test | production
PORT=3013
MONGODB_URI=                    # mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?appName=...
MONGODB_DB_NAME=addaapp
JWT_ACCESS_SECRET=              # >= 32 random chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_REFRESH_SECRET=             # >= 32 random chars, different from the access secret
OTP_HASH_SECRET=                # >= 16 random chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS_MOBILE=30
REFRESH_TOKEN_DAYS_PANEL=7
CORS_ORIGINS=http://localhost:5173   # comma-separated SocialPanel origins (https in production)
PUBLIC_API_BASE_URL=http://localhost:3013   # public https URL of this API (used for media links)
PANEL_BASE_URL=http://localhost:5173        # used in password setup links
TRUST_PROXY=                    # e.g. 1 when behind nginx / a load balancer

# SMS OTP: none | test | msg91 | twilio. "test" is refused when NODE_ENV=production.
OTP_PROVIDER=none
OTP_TEST_MODE=false
OTP_TEST_CODE=246810
OTP_PROVIDER_API_KEY=           # MSG91 authkey or Twilio auth token
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=

# Payments: none | razorpay | cashfree. Online collection stays disabled until keys are set AND a society is enabled by the super admin.
PAYMENT_PROVIDER=none
# Cashfree PG + Easy Split (skills/cashfree-payments). sandbox = "Test mode" everywhere. Webhook URL in the Cashfree
# dashboard: <PUBLIC_API_BASE_URL>/api/v1/payments/webhook/cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
RAZORPAY_KEY_ID=
PAYMENT_SECRET_KEY=             # Razorpay key secret
PAYMENT_WEBHOOK_SECRET=         # Razorpay webhook secret

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
STORAGE_SECRET=                 # HMAC key for signed private media URLs (defaults to JWT access secret)
MAX_UPLOAD_MB=8

SMTP_HOST=                      # optional: enables emailed setup/reset links
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

EXPO_ACCESS_TOKEN=              # optional: Expo push security token
PUSH_NOTIFICATION_CONFIG=
JOBS_ENABLED=true

# Interim resident sign-in with phone + password (no SMS). Phone numbers are NOT verified; turn off once SMS OTP works.
RESIDENT_PASSWORD_LOGIN=true
