# Base URL of the NIVASA API (no trailing slash, without /api/v1). Public value only — never put secrets here:
# it is compiled into the browser bundle. When the variable is missing the panel uses "/" (same origin).
# "/" = same origin: the host forwards /api and /media to the backend (Vercel: see vercel.json), so the browser
# never makes a cross-origin call and no CORS is involved. For a host without that forwarding, use
# VITE_API_BASE_URL=https://adda.skillinnovex.in instead.
VITE_API_BASE_URL=/
# Local development only (read by vite.config.js, never bundled): where `npm run dev` forwards /api and /media.
# DEV_PROXY_TARGET=http://127.0.0.1:3013
